{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "HVAC client record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "userId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "DiagnosisLog": {
      "title": "DiagnosisLog",
      "description": "Historical log of error code diagnosis searches done by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "brand": { "type": "string" },
        "code": { "type": "string" },
        "timestamp": { "type": "string" },
        "success": { "type": "boolean" },
        "result": { "type": "object" }
      },
      "required": ["id", "userId", "brand", "code", "timestamp", "success"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "desc": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out"] }
      },
      "required": ["id", "userId", "desc", "value", "date", "type"]
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "HVAC service order with reminder automation options",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "equipment": { "type": "string" },
        "serviceDate": { "type": "string" },
        "maintenanceIntervalMonths": { "type": "number" },
        "autoScheduleReminder": { "type": "boolean" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientName", "clientPhone", "equipment", "serviceDate", "maintenanceIntervalMonths", "autoScheduleReminder", "userId"]
    },
    "MaintenanceReminder": {
      "title": "MaintenanceReminder",
      "description": "Maintenance reminder generated from service order or created manually",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "equipment": { "type": "string" },
        "serviceDate": { "type": "string" },
        "monthsInterval": { "type": "number" },
        "technicianName": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "sent", "completed"] },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "clientName", "clientPhone", "equipment", "serviceDate", "monthsInterval", "userId"]
    },
    "FreeLicense": {
      "title": "FreeLicense",
      "description": "Free license code for promotional, trial or partner pro access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["trial", "partner", "promotional"] },
        "durationDays": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "code", "type", "durationDays", "maxUses", "usedCount", "active", "createdAt"]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "User subscription plan and license status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro_trial", "pro_paid"] },
        "licenseKeyUsed": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" }
      },
      "required": ["userId", "plan", "startDate", "endDate"]
    }
  },
  "firestore": {
    "/licenses/{licenseId}": {
      "schema": { "$ref": "#/entities/FreeLicense" },
      "description": "Promotional and trial free licenses"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Clients collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles collection"
    },
    "/users/{userId}/diagnosisLogs/{logId}": {
      "schema": { "$ref": "#/entities/DiagnosisLog" },
      "description": "User's searched error code diagnosis logs"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User's financial transactions"
    },
    "/users/{userId}/serviceOrders/{orderId}": {
      "schema": { "$ref": "#/entities/ServiceOrder" },
      "description": "User's completed service orders"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/MaintenanceReminder" },
      "description": "User's scheduled maintenance reminders"
    }
  }
}
