# Google Gemini AI API Key (Server-side only)
GEMINI_API_KEY=

# OpenWeatherMap API Key (Client-side)
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Admin & Security Configuration
NEXT_PUBLIC_ADMIN_EMAIL=amigorefrigerista@gmail.com
ADMIN_MASTER_EMAIL=amigorefrigerista@gmail.com
# Em produção multi-instância (Cloud Run), mantenha ENFORCE_STRICT_HMAC_ENV=true e defina SESSION_HMAC_SECRET (ex: `openssl rand -base64 48`)
SESSION_HMAC_SECRET=
ENFORCE_STRICT_HMAC_ENV=true
ALLOWED_ORIGINS=https://amigorefrigerista.com.br,https://app.amigorefrigerista.com.br

# Rate Limit & Quota Persistence (Redis / Upstash / Database)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRUSTED_PROXY_HEADER=x-real-ip

# Cloud SQL / PostgreSQL Configuration (Server-side only)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=false
SQL_SSL_REJECT_UNAUTHORIZED=true

# Mercado Pago & Webhooks (Server-side only)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp API & Webhook Verification (Server-side only)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Server-side SMTP Fallback (Optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
